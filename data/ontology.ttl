# =============================================================================
# PROPERTY RESTRICTIONS AND AXIOMS
# =============================================================================

# Transaction Status Values
exs:status rdfs:range [
    a owl:DataRange ;
    owl:oneOf (
        "settled"
        "pending"
        "rejected"
        "cancelled"
    )
] .

# Transaction Type Values
exs:transactionType rdfs:range [
    a owl:DataRange ;
    owl:oneOf (
        "expense"
        "income"
        "transfer"
    )
] .

# Card Status Values
exs:cardStatus rdfs:range [
    a owl:DataRange ;
    owl:oneOf (
        "active"
        "inactive"
        "blocked"
        "expired"
    )
] .

# Card Type Values
exs:cardType rdfs:range [
    a owl:DataRange ;
    owl:oneOf (
        "debit"
        "credit"
        "prepaid"
    )
] .

# Tax Class Values
exs:taxClass rdfs:range [
    a owl:DataRange ;
    owl:oneOf (
        "standard"
        "reduced"
        "zero"
        "exempt"
    )
] .

# =============================================================================
# FUNCTIONAL PROPERTIES
# =============================================================================

# Each card can only have one scheme operator
exs:cardSchemeOperator a owl:FunctionalProperty .

# Each card can only be linked to one account
exs:linkedAccount a owl:FunctionalProperty .

# Each merchant can only have one category
exs:merchantCategory a owl:FunctionalProperty .

# Each transaction can only have one status
exs:status a owl:FunctionalProperty .

# Each transaction can only have one type
exs:transactionType a owl:FunctionalProperty .

# Each transaction can only have one value date
exs:valueDate a owl:FunctionalProperty .

# Each card can only have one number
exs:cardNumber a owl:FunctionalProperty .

# Each card can only have one status
exs:cardStatus a owl:FunctionalProperty .

# Each card can only have one type
exs:cardType a owl:FunctionalProperty .

# Each card can only have one expiry date
exs:expiryDate a owl:FunctionalProperty .

# Each product category can only have one CO2 factor
exs:co2Factor a owl:FunctionalProperty .

# Each product category can only have one tax class
exs:taxClass a owl:FunctionalProperty . 